{
  "name": "bika-movie-anime-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram Anime catalog bot with historical channel indexing and timed message cleanup",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:importer": "tsx watch src/importer/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:bot": "node dist/bot/index.js",
    "start:importer": "node dist/importer/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "db:indexes": "tsx scripts/setup-indexes.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "mongodb": "^6.13.0",
    "teleproto": "^1.230.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}